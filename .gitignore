# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.python-version

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
notebooks/outputs/

# Environment secrets — never commit
.env
.env.*

# Build artifacts
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Log files (runtime logs go to outputs/, not the repo)
*.log

# Large binary artifacts — PyTorch checkpoints, numpy arrays, HF weights
*.pt
*.npz
*.npy
*.safetensors
*.pkl
*.pickle

# Experiment outputs, caches, and data (all runtime-generated)
data/
outputs/
runs/
artifacts/

# SLURM job output files
slurm-*.out
slurm-*.err
logs/

# HuggingFace model cache (if symlinked into repo)
hf_cache/
model_cache/

# Tool caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# ML experiment tracking
wandb/
mlruns/

# Profiling
*.prof

# Claude Code per-project local settings (machine-specific, not for VCS)
.claude/

# Generated binary documents (e.g. README.pdf exported from README.md)
*.pdf
# ...but keep the thesis figures shipped with the docs
!docs/*.pdf

# Project-specific AI guidance (not for public consumption)
CLAUDE.md
